# Guardian frontend configuration.
#
# ONLY variables prefixed with VITE_ reach the browser bundle. That is a Vite
# rule and a deliberate guardrail: it is what keeps OPERATOR_PRIVATE_KEY and
# anything else in the shared root .env out of the shipped JavaScript.
# Do not work around it — no `define:` entries in vite.config.ts, no process.env
# access in src/.

# Base URL of the Guardian API. Required; the app refuses to start without it.
# In docker compose, the API on the host is reachable at host.docker.internal.
VITE_API_URL=http://localhost:3000
