# Guardian — environment template.
# Copy to .env and fill in. .env is gitignored; this file is not.

# ---------------------------------------------------------------- Rain (STUBBED)
# Rain cannot deliver to Monad (not a supported payment-route rail, confirmed with
# Rain). Onramp/offramp endpoints exist and LOG the request they would send, but no
# call is made. Flip to true only if a Monad rail appears.
RAIN_ENABLED=false
# One team + one user for the whole platform — Rain identities are NOT per end-user.
RAIN_BASE_URL=https://api-dev.raincards.xyz/v1
RAIN_API_KEY=
RAIN_TEAM_ID=
RAIN_USER_ID=
RAIN_COLLATERAL_CONTRACT_ID=

# ---------------------------------------------------------------- Monad Testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=https://testnet.monadvision.com
# Canonical test USDC on Monad Testnet, 6 decimals — confirmed with Monad
USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
ESCROW_CONTRACT_ADDRESS=

# Funder wallet — the source of all test money. Mint MON + test USDC here from the
# faucets; it funds user top-ups. Replaces the Rain onramp.
FUNDER_PRIVATE_KEY=
FUNDER_ADDRESS=

# Deployer — a SEPARATE throwaway key, used once by forge script. Needs MON only.
# Nothing in the running system uses it; safe to discard after deployment.
DEPLOYER_PRIVATE_KEY=

# Two separate keys on purpose (smart-contract §3.5): a leaked GUARDIAN key can only
# mis-rule a dispute, never open deals or move funds elsewhere. Both need MON for gas.
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
GUARDIAN_ADDRESS=
GUARDIAN_PRIVATE_KEY=

# ---------------------------------------------------------------- Anthropic
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guardian

# ---------------------------------------------------------------- Demo tuning
# Seconds. Production default is 86400 (24h); the demo turns it down so an
# uncontested trade visibly auto-releases on stage. Never 0 — see
# smart-contract §11.3.
REVIEW_WINDOW_SECONDS=30
SWEEPER_INTERVAL_MS=3000
